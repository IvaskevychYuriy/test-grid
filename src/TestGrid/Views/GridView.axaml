<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TestGrid.ViewModels"
             x:Class="TestGrid.Views.GridView"
             x:DataType="vm:GridViewModel">
  <DataGrid x:Name="ItemsGrid"
            ItemsSource="{Binding Items}"
            Height="{Binding ViewportHeight}"
            VerticalAlignment="Top"
            RowHeight="{x:Static vm:GridViewModel.RowHeight}"
            ColumnHeaderHeight="{x:Static vm:GridViewModel.HeaderHeight}"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            CanUserSortColumns="False">
    <DataGrid.Styles>
      <Style Selector="DataGridRow" x:DataType="vm:ItemViewModel">
        <Setter Property="Classes.highlighted" Value="{Binding IsHighlighted}" />
        <Setter Property="Transitions">
          <Transitions>
            <BrushTransition Property="Background" Duration="0:0:0.3" />
          </Transitions>
        </Setter>
      </Style>
      <Style Selector="DataGridRow.highlighted">
        <Setter Property="Background" Value="#664CAF50" />
      </Style>
    </DataGrid.Styles>
    <DataGrid.Columns>
      <DataGridTextColumn Header="Name" Width="*" Binding="{Binding Name, Mode=OneWay, x:DataType=vm:ItemViewModel}" />
      <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, Mode=OneWay, x:DataType=vm:ItemViewModel}" />
      <DataGridTextColumn Header="Price" Binding="{Binding Price, Mode=OneWay, StringFormat=F2, x:DataType=vm:ItemViewModel}" />
      <DataGridTextColumn Header="Modified (UTC)" Width="180" Binding="{Binding ModifiedOn, Mode=OneWay, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}', x:DataType=vm:ItemViewModel}" />
    </DataGrid.Columns>
  </DataGrid>
</UserControl>
