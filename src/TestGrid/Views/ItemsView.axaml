<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TestGrid.ViewModels"
             xmlns:views="using:TestGrid.Views"
             x:Class="TestGrid.Views.ItemsView"
             x:DataType="vm:ItemsViewModel">
  <views:GridView DataContext="{Binding Grid}" />
</UserControl>
