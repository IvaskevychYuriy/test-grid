<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TestGrid.ViewModels"
             xmlns:views="using:TestGrid.Views"
             x:Class="TestGrid.Views.ItemsView"
             x:DataType="vm:ItemsViewModel">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top"
               Margin="8"
               FontWeight="Bold"
               TextWrapping="Wrap"
               Text="{Binding ConditionsDescription}" />
    <Border DockPanel.Dock="Bottom"
            Height="182"
            Margin="0,8,0,0"
            BorderThickness="1"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Grid.ChangeLog}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Height="18"
                         Margin="6,0"
                         FontFamily="Cascadia Mono, Consolas, monospace"
                         FontSize="12"
                         Text="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
    <views:GridView DataContext="{Binding Grid}" />
  </DockPanel>
</UserControl>
